{
  "name": "agent-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "rebuild:native": "node scripts/rebuild-better-sqlite3.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm --filter @agent-platform/contracts build && pnpm --filter @agent-platform/agent-validation build && pnpm --filter @agent-platform/logger build && pnpm --filter @agent-platform/db build && pnpm --filter @agent-platform/mcp-adapter build && pnpm --filter @agent-platform/model-router build && pnpm --filter @agent-platform/plugin-sdk build && pnpm --filter @agent-platform/plugin-session build && pnpm --filter @agent-platform/plugin-observability build && pnpm --filter @agent-platform/planner build && pnpm --filter @agent-platform/harness build && pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"apps/**/*.{ts,json,md}\" \"packages/**/*.{ts,json,md}\" \"e2e/**/*.{ts,json,md}\" \"*.{js,json}\" \"README.md\" \"CONTRIBUTING.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,json,md}\" \"packages/**/*.{ts,json,md}\" \"e2e/**/*.{ts,json,md}\" \"*.{js,json}\" \"README.md\" \"CONTRIBUTING.md\"",
    "seed": "pnpm --filter @agent-platform/db run seed",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "docs:lint": "pnpm docs:lint:md && pnpm docs:lint:links",
    "docs:lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules\" \"#dist\" \"#**/dist\" \"#.next\" \"#**/.next\" \"#coverage\" \"#**/coverage\" \"#test-results\" \"#data\" \"#packages/db/drizzle\"",
    "docs:lint:links": "node scripts/check-doc-links.mjs",
    "deps:check-cycles": "madge --circular --extensions ts,tsx,js --ts-config apps/web/tsconfig.json --warning packages apps",
    "deps:visualize": "madge --image deps-graph.svg --ts-config apps/web/tsconfig.json packages apps",
    "prepare": "husky",
    "postinstall": "node scripts/fix-node-pty-helpers.mjs",
    "diagnostics": "node scripts/diagnostics.mjs"
  },
  "lint-staged": {
    "*.{ts,json,md,js}": "prettier --write",
    "*.ts": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "madge": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "form-data@4": "4.0.6",
      "ip-address@10": "10.7.4",
      "js-yaml@4": "4.3.2",
      "linkify-it@5": "5.0.2",
      "multer@2": "2.4.0",
      "nanoid@3": "3.3.20",
      "postcss@8": "8.5.30",
      "proxy-addr@2": "2.0.8",
      "shell-quote@1": "1.12.0",
      "source-map-js@1": "1.2.2",
      "undici@7": "7.30.1",
      "qs@6": "6.16.1",
      "body-parser@1": "1.20.8",
      "@humanfs/node@0.16": "0.16.8",
      "markdown-it@14": "14.3.3"
    }
  }
}
