#!/bin/sh

# Get changed packages by diffing against remote tracking branch
REMOTE_REF=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null || echo "origin/main")

CHANGED_PKGS=$(git diff --name-only "$REMOTE_REF"...HEAD 2>/dev/null | \
  grep -oE '^(packages/[^/]+|apps/[^/]+)' | sort -u)

# Git exports repository-local variables to hooks. Once discovery is complete,
# do not let those variables redirect checks' temporary Git repositories here.
HOOK_GIT_LOCAL_NAMES=$(git rev-parse --local-env-vars) || exit 1
for HOOK_GIT_LOCAL_NAME in $HOOK_GIT_LOCAL_NAMES; do
  unset "$HOOK_GIT_LOCAL_NAME"
done

if [ -z "$CHANGED_PKGS" ]; then
  echo "[pre-push] No package changes detected, skipping checks."
  exit 0
fi

echo "[pre-push] Changed packages: $(echo "$CHANGED_PKGS" | tr '\n' ' ')"

# Run circular dependency check for developer feedback
echo "[pre-push] Running circular dependency check..."
pnpm deps:check-cycles || { echo "[pre-push] Circular dependency check failed. Run 'pnpm deps:check-cycles' to inspect."; exit 1; }

# Build filter args for pnpm
FILTERS=""
NON_API_TEST_FILTERS=""
RUN_API_BENCHMARK=0
for pkg in $CHANGED_PKGS; do
  PKG_NAME=$(node -e "try{console.log(require('./$pkg/package.json').name)}catch{}" 2>/dev/null)
  if [ -n "$PKG_NAME" ]; then
    FILTERS="$FILTERS --filter $PKG_NAME"
    if [ "$PKG_NAME" = '@agent-platform/api' ]; then
      RUN_API_BENCHMARK=1
    else
      NON_API_TEST_FILTERS="$NON_API_TEST_FILTERS --filter $PKG_NAME"
    fi
  fi
done

if [ -z "$FILTERS" ]; then
  echo "[pre-push] No pnpm packages matched, skipping."
  exit 0
fi

echo "[pre-push] Running build, typecheck, and test on affected packages..."
eval "pnpm $FILTERS run build" || exit $?
eval "pnpm $FILTERS run typecheck" || exit $?
if [ -n "$NON_API_TEST_FILTERS" ]; then
  eval "pnpm $NON_API_TEST_FILTERS run test" || exit $?
fi
if [ "$RUN_API_BENCHMARK" = 1 ]; then
  # Match CI: preserve every ordinary API test, then measure the complete benchmark in a fresh
  # process after all other suites finish. The API suite deliberately reuses its Vitest fork.
  pnpm --filter @agent-platform/api run test --maxWorkers=1 --minWorkers=1 --no-file-parallelism --exclude '**/diagnostics.performance.test.ts' || exit $?
  pnpm --filter @agent-platform/api exec vitest run test/diagnostics.performance.test.ts --maxWorkers=1 --minWorkers=1 --no-file-parallelism || exit $?
fi
