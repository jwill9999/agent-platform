  "objective": "Supervised prerequisite repair: enforce durable per-run aggregate execution allowances and deadline cleanup; no live pilot launch.",
  "requirements": [
    "B1 contract-bound aggregate/attempt/cleanup limits with approval invalidation and authority narrowing",
    "B2 atomic fenced immutable charged reservations across specialist/coordinator/repair/retry/recovery",
    "B3 work deadlines, bounded cleanup, durable exhaustion and restart/clock/journal failure containment",
    "B4 independently persisted reservation and composed child-process evidence"
  ],
  "nonGoals": [
    "Pilot launch or persisted managed approval",
    "Paid model call or primary credentials",
    "Product/UI/dependency changes",
    "Network permission changes",
    "Staging/main promotion"
  ],
  "acceptanceCriteria": [
    "B1 validated optional execution limits preserve legacy behavior and reject removal/increase without revised authority",
    "B2 total durable reserved work-plus-cleanup allowance never exceeds approved aggregate and replay never replenishes",
    "B3 expired/fenced/unknown authority cannot dispatch or accept results; owned cancellation and revocation are independently verified or reported blocked",
    "B4 B-T01 through B-T05 pass with exact source/material evidence and disclosed mocked/unverified boundaries"
  ],
  "constraints": {
    "architecture": [
      "Existing workflow SQLite writer lock, phase runtime and cancellation journal; no replacement coordinator",
      "Final pilot requires3600-second aggregate policy; repairs share the same run total"
    ],
    "security": [
      "No permissions/credential/network expansion",
      "Containment cleanup may run after work budget fence but cannot progress; uncertain physical absence blocks readiness",
      "Supervised direct repair and instruction-constrained independent no-tool critique, not active managed execution"
    ],
